# Jueves de Satoshi — Seguridad y URLs limpias

# Proteger archivos sensibles
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql|.*\.sql|.*\.md)$">
  Require all denied
</FilesMatch>

# Sin listado de directorios
Options -Indexes

RewriteEngine On

# robots.txt, sitemap.xml y llms.txt se generan con la marca de cada instalación
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^llms\.txt$ llms.php [L]

# URLs limpias de los años: /2026 sirve year.php?y=2026.
# La bandera E= le avisa a PHP que esta regla existe: el sitio solo genera
# enlaces cortos cuando de verdad funcionan, así que un .htaccess viejo no
# deja enlaces rotos.
RewriteRule ^ - [E=JDS_CLEAN_URLS:1]
RewriteRule ^([0-9]{4})/?$ year.php?y=$1 [L,QSA]
# Solo responde en el sitio maestro; en un nodo instalar.php da 404
RewriteRule ^monta-el-tuyo/?$ instalar.php [L,QSA]

# Forzar HTTPS (descomentar al activar SSL en el hosting)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Headers de seguridad
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
